# EmailJS — create a template with these variable names:
# from_name, reply_to, company, message
NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=

# Optional. When set, the Projects page attaches production and GitHub
# URLs from the Vercel REST API for matching project names.
VERCEL_ACCESS_TOKEN=
VERCEL_TEAM_ID=

# Optional. Points the resume certificate at an issued PDF or image.
# Defaults to /fes-certificate.svg
NEXT_PUBLIC_FES_CERTIFICATE_URL=
